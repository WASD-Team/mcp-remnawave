{
    "name": "remnawave-mcp",
    "version": "1.2.0",
    "description": "MCP server for Remnawave proxy management panel",
    "type": "module",
    "bin": {
        "remnawave-mcp": "dist/index.js"
    },
    "main": "dist/index.js",
    "scripts": {
        "build": "tsup",
        "dev": "tsup --watch",
        "start": "node dist/index.js",
        "typecheck": "tsc --noEmit",
        "test": "esbuild tests/regression.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/regression.mjs --external:@modelcontextprotocol/sdk --log-level=error && node node_modules/.cache/regression.mjs",
        "check:bodies": "esbuild tests/body-coverage.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/body-coverage.mjs --log-level=error && node node_modules/.cache/body-coverage.mjs"
    },
    "keywords": [
        "mcp",
        "remnawave",
        "vpn",
        "proxy",
        "xray"
    ],
    "license": "MIT",
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.12.1",
        "@remnawave/backend-contract": "^3.2.0",
        "zod": "^3.25.76"
    },
    "devDependencies": {
        "@types/node": "^22.0.0",
        "esbuild": "^0.27.0",
        "tsup": "^8.0.0",
        "typescript": "^5.7.0"
    },
    "engines": {
        "node": ">=22.0.0"
    }
}
